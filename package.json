{
  "name": "chasewcole-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input && pnpm token-lint && prettier --check .",
    "token-lint": "tsx tools/token-lint/cli.ts",
    "format": "prettier --write .",
    "test": "vitest run --project unit --project dom",
    "test:stories": "vitest run --project stories",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=site",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/ui/src/**/*.{ts,tsx,css}": "tsx tools/token-lint/cli.ts",
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@cwc/tokens": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "storybook": "^10.6.8",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
